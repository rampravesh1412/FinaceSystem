# Reference copy of /srv/amiri/deploy/api.env — mounted into the api container as its
# env_file. bootstrap-server.sh writes the real one with generated secrets.
#
# MONGODB_URI is deliberately absent: docker-compose.prod.yml assembles it from the
# credentials in .env, so the database password lives in exactly one file.

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

MONGODB_DB_NAME=amiri_finance

# At least 32 characters each and different from each other — env.ts refuses to boot
# otherwise, and a shared secret would let a leaked access token be replayed as a refresh
# token. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_HOURS=6

# Same-origin deployment, so the browser never sends a cross-origin request. The
# allowlist still governs anything else that calls the API. No wildcard: env.ts rejects
# one outright in production.
CORS_ORIGINS=https://account.amiri247.in
COOKIE_SECURE=true
COOKIE_DOMAIN=account.amiri247.in

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

LOG_LEVEL=info

# Relative to /app/apps/api inside the container, where /srv/amiri/uploads is mounted.
UPLOAD_DIR=./uploads
PUBLIC_URL=https://account.amiri247.in

ORG_NAME=AMIRI Finance
ORG_CURRENCY=INR
FISCAL_YEAR_START_MONTH=4
