# Reference copy of /srv/amiri/deploy/.env — docker compose reads it from the directory
# holding docker-compose.prod.yml. bootstrap-server.sh writes the real one with generated
# secrets; this file exists so the shape is reviewable in git. Never commit the real one.

DATA_DIR=/srv/amiri
SERVER_NAME=account.amiri247.in

# Rewritten by deploy.sh on every release. The tag is the commit sha, so what is running
# is always traceable to a commit.
API_IMAGE=ghcr.io/rampravesh1412/finacesystem-api:sha-0000000000000000000000000000000000000000
WEB_IMAGE=ghcr.io/rampravesh1412/finacesystem-web:sha-0000000000000000000000000000000000000000

MONGO_ROOT_USER=amiri_root
# Hex on purpose — it is spliced into MONGODB_URI and would otherwise need
# percent-encoding. Generate with: openssl rand -hex 32
MONGO_ROOT_PASSWORD=

# Nights of mongodump to keep in $DATA_DIR/backups.
BACKUP_RETAIN_DAYS=14
