# Copy to apps/api/.env and fill in.
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# The replica set started by `npm run db:up`. Multi-document transactions require a
# replica set — a standalone mongod is rejected at boot. See docker-compose.yml.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=amiri_finance

# MUST be different from each other, and at least 32 characters each.
JWT_ACCESS_SECRET=change-me-dev-only-0000000000000000000000000000000000
JWT_REFRESH_SECRET=change-me-dev-only-1111111111111111111111111111111111
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourdomain.com

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

LOG_LEVEL=info

UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:4000

ORG_NAME=AMIRI Finance
ORG_CURRENCY=INR
# India runs April–March.
FISCAL_YEAR_START_MONTH=4
